# The four machines a three-member cluster is measured across.
#
#   node0  the controller: runs run-cluster-4host.sh and the reference harness,
#          and is cluster member 0
#   node1  cluster member 1
#   node2  cluster member 2
#   client the load: the reference's cluster-client and its own media driver
#
# All four must be the same instance type (c7.8xlarge: 16 cores, no SMT) and on
# the same VPC/subnet. Everything below is a default that can be overridden from
# the environment before this file is sourced.
#
# ★ The two new hosts are deliberately *unset*: a run that guessed an address
# would measure a machine nobody described. `cluster_require_hosts` refuses.

CLUSTER_NODE0_SSH=${CLUSTER_NODE0_SSH:-root@172.16.1.15}
CLUSTER_NODE1_SSH=${CLUSTER_NODE1_SSH:-root@172.16.1.19}
CLUSTER_NODE2_SSH=${CLUSTER_NODE2_SSH:-root@172.16.1.20}
CLUSTER_CLIENT_SSH=${CLUSTER_CLIENT_SSH:-root@172.16.1.17}

CLUSTER_SSH_KEY=${CLUSTER_SSH_KEY:-/root/.ssh/id_ed25519}
CLUSTER_ID=${CLUSTER_ID:-7}

# Ports come out of one block per member, above Linux's ephemeral range
# (32768-60999): a port inside it can be taken by any process mid-run, and a
# cluster that loses one of its own endpoints fails like a cluster bug.
CLUSTER_PORT_BASE=${CLUSTER_PORT_BASE:-62000}
CLUSTER_PORT_STRIDE=${CLUSTER_PORT_STRIDE:-100}

# Cores. Sixteen per machine, one thread each. The driver's three come from the
# properties the harness writes; the node's five are pinned by thread name after
# the JVM starts (the reference harness does the same); the client's four are
# its own.
DRIVER_CONDUCTOR_CPU=${DRIVER_CONDUCTOR_CPU:-1}
DRIVER_SENDER_CPU=${DRIVER_SENDER_CPU:-2}
DRIVER_RECEIVER_CPU=${DRIVER_RECEIVER_CPU:-3}
ARCHIVE_RECORDER_CPU=${ARCHIVE_RECORDER_CPU:-4}
ARCHIVE_REPLAYER_CPU=${ARCHIVE_REPLAYER_CPU:-5}
ARCHIVE_CONDUCTOR_CPU=${ARCHIVE_CONDUCTOR_CPU:-6}
CONSENSUS_MODULE_CPU=${CONSENSUS_MODULE_CPU:-7}
CLUSTERED_SERVICE_CPU=${CLUSTERED_SERVICE_CPU:-0}
NON_ISOLATED_CPU_CORES=${NON_ISOLATED_CPU_CORES:-0,1}
CLIENT_DRIVER_CONDUCTOR_CPU=${CLIENT_DRIVER_CONDUCTOR_CPU:-2}
CLIENT_DRIVER_SENDER_CPU=${CLIENT_DRIVER_SENDER_CPU:-4}
CLIENT_DRIVER_RECEIVER_CPU=${CLIENT_DRIVER_RECEIVER_CPU:-6}
CLIENT_LOAD_TEST_RIG_CPU=${CLIENT_LOAD_TEST_RIG_CPU:-8}
CLIENT_NON_ISOLATED_CPU_CORES=${CLIENT_NON_ISOLATED_CPU_CORES:-0,10}

# The same paths on every host, because the harness generates scripts here and
# runs them there.
CLUSTER_BENCHMARKS_PATH=${CLUSTER_BENCHMARKS_PATH:-/root/bench/benchmarks-deepmsg}
CLUSTER_JAVA_HOME=${CLUSTER_JAVA_HOME:-/usr/lib/jvm/java-21-openjdk-amd64}
CLUSTER_DEEPMSG_DIR=${CLUSTER_DEEPMSG_DIR:-/root/bench/deepmsg}
CLUSTER_DATA_DIR=${CLUSTER_DATA_DIR:-/root/bench/cluster-data}

# What is measured. The client link on this VPC carries all four; the 1GbE limit
# that narrowed the bench-machine grid to two tiers does not apply here.
CLUSTER_RATES=${CLUSTER_RATES:-25K,101K,301K,501K}
CLUSTER_LENGTHS=${CLUSTER_LENGTHS:-32,1344,288,32}
CLUSTER_ITERATIONS=${CLUSTER_ITERATIONS:-60}
CLUSTER_WARMUP_ITERATIONS=${CLUSTER_WARMUP_ITERATIONS:-30}
CLUSTER_WARMUP_RATE=${CLUSTER_WARMUP_RATE:-25K}
CLUSTER_FSYNC_LEVELS=${CLUSTER_FSYNC_LEVELS:-0}
CLUSTER_MTU=${CLUSTER_MTU:-1408}

_cluster_host_of() { printf '%s' "${1#*@}"; }

cluster_require_hosts() {
    local missing=0
    for _name in CLUSTER_NODE0_SSH CLUSTER_NODE1_SSH CLUSTER_NODE2_SSH CLUSTER_CLIENT_SSH; do
        if [ -z "${!_name}" ]; then
            echo "cluster: $_name is unset — say which machine it is in hosts.env or the environment" >&2
            missing=1
        fi
    done
    [ "$missing" -eq 0 ] || return 1
    local _seen=" " _ip
    for _name in CLUSTER_NODE0_SSH CLUSTER_NODE1_SSH CLUSTER_NODE2_SSH CLUSTER_CLIENT_SSH; do
        _ip=$(_cluster_host_of "${!_name}")
        case "$_seen" in
            *" $_ip "*) echo "cluster: $_ip is named twice (via $_name)" >&2; missing=1 ;;
        esac
        _seen="$_seen$_ip "
    done
    [ "$missing" -eq 0 ]
}

# A member's own ports and channels. `id,ingress,consensus,log,catchup,archive`
# is the reference's six-field member form; the consensus module dials the
# archive through the sixth.
cluster_member_ports() { # <id> -> "ingress consensus log catchup archive"
    local id=$1
    local base=$((CLUSTER_PORT_BASE + id * CLUSTER_PORT_STRIDE))
    printf '%s %s %s %s %s\n' $base $((base + 1)) $((base + 2)) $((base + 3)) $((base + 4))
}

cluster_members_string() {
    local id ip ports
    local out=""
    for id in 0 1 2; do
        case $id in
            0) ip=$(_cluster_host_of "$CLUSTER_NODE0_SSH") ;;
            1) ip=$(_cluster_host_of "$CLUSTER_NODE1_SSH") ;;
            2) ip=$(_cluster_host_of "$CLUSTER_NODE2_SSH") ;;
        esac
        read -r p_ingress p_consensus p_log p_catchup p_archive <<<"$(cluster_member_ports "$id")"
        out+="${id},${ip}:${p_ingress},${ip}:${p_consensus},${ip}:${p_log},${ip}:${p_catchup},${ip}:${p_archive}|"
    done
    printf '%s' "${out%|}"
}

# `0=ip:port,1=ip:port,2=ip:port` — the reference client's own form.
cluster_ingress_endpoints() {
    local id ip p_ingress _rest
    local out=""
    for id in 0 1 2; do
        case $id in
            0) ip=$(_cluster_host_of "$CLUSTER_NODE0_SSH") ;;
            1) ip=$(_cluster_host_of "$CLUSTER_NODE1_SSH") ;;
            2) ip=$(_cluster_host_of "$CLUSTER_NODE2_SSH") ;;
        esac
        read -r p_ingress _rest <<<"$(cluster_member_ports "$id")"
        out+="${id}=${ip}:${p_ingress},"
    done
    printf '%s' "${out%,}"
}
