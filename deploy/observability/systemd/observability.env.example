# /etc/deepmsg/observability.env — copy, fill, chmod 0600 (it holds the token).
#
# The endpoints are vmauth's, on the log host: in the single profile that is
# 127.0.0.1; in the cluster profile it is the log host's private address.
# The agent runs on every media-driver host; the backends and vmauth run on the
# log host, never on a media-driver host.

DEEPMSG_LOG_DIR=/var/log/deepmsg
DEEPMSG_OBS_STATE_DIR=/var/lib/deepmsg-otelcol
DEEPMSG_COUNTERS_ENDPOINT=127.0.0.1:9101
DEEPMSG_OTELCOL_TELEMETRY_ENDPOINT=127.0.0.1:8888
DEEPMSG_VL_LOGS_ENDPOINT=http://127.0.0.1:8427/insert/opentelemetry/v1/logs
DEEPMSG_VM_WRITE_ENDPOINT=http://127.0.0.1:8427/api/v1/write
DEEPMSG_OBS_WRITE_TOKEN=replace-me
DEEPMSG_HOSTMETRICS_ROOT=/
