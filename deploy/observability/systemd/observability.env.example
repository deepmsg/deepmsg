# /etc/deepmsg/observability.env — copy, fill, chmod 0600 (it holds the token).
#
# The endpoints are vmauth's, on the log host: in the single profile that is
# 127.0.0.1; in the cluster profile it is the log host's private address.
# The agent runs on every media-driver host; the backends and vmauth run on the
# log host, never on a media-driver host.

DEEPMSG_LOG_DIR=/var/log/deepmsg
DEEPMSG_OBS_STATE_DIR=/var/lib/deepmsg-otelcol
DEEPMSG_NODE_ID=node-1
# Both exporters read the driver's aeron directory: the counters and the
# driver's distinct error log live in its CnC file there. This is the same
# directory the driver was given (-Daeron.dir), usually under /dev/shm.
DEEPMSG_AERON_DIR=/dev/shm/aeron
# The cluster member's directory, which the error-log exporter also watches.
# Empty on a host that runs no cluster: the cluster source is then off.
DEEPMSG_CLUSTER_DIR=
DEEPMSG_COUNTERS_ENDPOINT=127.0.0.1:9101
DEEPMSG_OTELCOL_TELEMETRY_ENDPOINT=127.0.0.1:8888
DEEPMSG_VL_LOGS_ENDPOINT=http://127.0.0.1:8427/insert/opentelemetry/v1/logs
DEEPMSG_VM_WRITE_ENDPOINT=http://127.0.0.1:8427/api/v1/write
DEEPMSG_OBS_WRITE_TOKEN=replace-me
DEEPMSG_HOSTMETRICS_ROOT=/

# Grafana on the log host (the read token is not the agent's write token).
# The datasources' URL is vmauth's. In the cluster profile vmauth listens on the
# log host's private address (the agents on the media hosts connect to it), so
# this is that address even though Grafana is on the same host.
DEEPMSG_VMAUTH_URL=http://127.0.0.1:8427
DEEPMSG_GRAFANA_READ_TOKEN=replace-me
DEEPMSG_GRAFANA_DASHBOARDS_DIR=/etc/deepmsg/grafana/provisioning/dashboards
DEEPMSG_GRAFANA_WEBHOOK_URL=http://127.0.0.1:9099/alerts
GF_SECURITY_ADMIN_PASSWORD=replace-me
