# The Grafana side's pinned releases.
#
# The Grafana tarball is about 482 MB and the plugin about 79 MB; the fetch
# script caches them under target/observability-tools and verifies these hashes
# on every run, so a changed asset is a failure rather than a surprise.
#
# 2026-11-06: the latest releases (Grafana v13.3.0, the VictoriaLogs
# datasource v0.33.1). Re-resolve the tag and the hash together when bumping.

GRAFANA_VERSION=13.3.0
GRAFANA_ASSET=grafana-${GRAFANA_VERSION}.linux-amd64.tar.gz
GRAFANA_SHA256=cec8f98cc59bc1a1945833b652371a073be678c5c159a9b1695ad63c04fae5a7

PLUGIN_VERSION=0.33.1
PLUGIN_ASSET=victoriametrics-logs-datasource-v${PLUGIN_VERSION}.zip
PLUGIN_SHA256=73e7ce379ae9a9ce6fdb978e5d6d43f67029b4c3e4d970f1ca8f7f4617f331c5
