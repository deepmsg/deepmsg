# The releases the L2 end-to-end scripts run, pinned.
#
# These are the `/releases/latest` tags on 2026-11-05 (otelcol-contrib
# v0.164.0, VictoriaLogs v1.53.0, VictoriaMetrics v1.155.0) and the SHA256 of
# the linux-amd64 asset each one names. Re-resolve the tag and the hash
# together when bumping: fetch-tools.sh refuses an asset that does not match.
#
# The architecture is amd64 because the bench and the cloud machines are. A
# second architecture needs its own asset names and hashes, not a `sed`.

OTELCOL_VERSION=0.164.0
OTELCOL_ASSET=otelcol-contrib_${OTELCOL_VERSION}_linux_amd64.tar.gz
OTELCOL_BINARY=otelcol-contrib
OTELCOL_SHA256=f0c1ce9f661399beb4a58b711924716e08ea70c3802db0715fcfde3cbbada2d4

VICTORIA_LOGS_VERSION=1.53.0
VICTORIA_LOGS_ASSET=victoria-logs-linux-amd64-v${VICTORIA_LOGS_VERSION}.tar.gz
VICTORIA_LOGS_BINARY=victoria-logs-prod
VICTORIA_LOGS_SHA256=55feba89713cafa952673f91b8b38e7701bb0290989263da671b47a0de16edd3

VICTORIA_METRICS_VERSION=1.155.0
VICTORIA_METRICS_ASSET=victoria-metrics-linux-amd64-v${VICTORIA_METRICS_VERSION}.tar.gz
VICTORIA_METRICS_BINARY=victoria-metrics-prod
VICTORIA_METRICS_SHA256=7180e65913d55ab99c0be8f4a3ad17a0fafe5598a21ff6327fecba3190d7b176

VMUTILS_ASSET=vmutils-linux-amd64-v${VICTORIA_METRICS_VERSION}.tar.gz
VMUTILS_BINARY=vmauth-prod
VMAUTH_BINARY=vmauth
VMUTILS_SHA256=b6181fc16cf19835706ea5d67215eea56c1fe87350fdfd82a5ff803ea2c1a907
